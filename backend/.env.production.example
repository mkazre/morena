# Production settings for https://app.morenagroup.co.za (cPanel).
# Copy to ".env" in the app folder on the server and fill in every value marked CHANGE_ME.
# Never commit the real .env.

APP_NAME="Morena CRM"
APP_ENV=production
APP_KEY=CHANGE_ME
APP_DEBUG=false
APP_URL=https://app.morenagroup.co.za
APP_TIMEZONE=Africa/Johannesburg
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# cPanel → MySQL Databases. cPanel prefixes names with your account user, e.g. abcuser_morena_crm.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Sessions are cookie + database; locked to the app subdomain, HTTPS only.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=app.morenagroup.co.za
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=app.morenagroup.co.za

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# cPanel → Email Accounts: create e.g. noreply@morenagroup.co.za, then use its "Connect Devices" SMTP settings.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.morenagroup.co.za
MAIL_PORT=465
MAIL_USERNAME=noreply@morenagroup.co.za
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="noreply@morenagroup.co.za"
MAIL_FROM_NAME="Morena Properties"
